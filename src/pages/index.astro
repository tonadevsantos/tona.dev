---
import Layout from "../layouts/Layout.astro";
import Tona from "../views/Tona.astro";
import Window from "../components/Window.astro";
import Display from "../views/Display.astro";
import { links } from "../content/links";
import Link from "../components/Link.astro";
---

<Layout title="tona.dev / Sup!">
  <div class="tona-grid grid grid-cols-3 gap-4 px-4">
    <div class="col-span-3 md:col-span-2">
      <Window>
        <Tona />
      </Window>
    </div>
    <div class="col-span-2 md:col-span-1">
      <Window class="flex flex-col justify-center">
        <Display />
      </Window>
    </div>
    <div class="col-span-1 md:col-span-3">
      <Window class="h-24 flex flex-col justify-center">
        <div class="flex justify-center align-center mb-4 gap-4">
          {
            links.map((link) => (
              <Link
                href={link.url}
                class="text-lg "
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.name}
              </Link>
            ))
          }
        </div>
      </Window>
    </div>
  </div>
</Layout>

<style lang="scss">
  @import "../styles/theme.scss";

  .hero {
    @include md {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    @include xl {
      margin-top: calc(35dvh - $navbar-height-tablet);
    }
  }

  .main-hero {
    display: flex;
    justify-content: center;
    flex-direction: column;
    width: 100%;
    gap: 2rem;

    @include xl {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .tona-box {
      @extend %box-padding;

      height: 100%;

      display: flex;
      flex-direction: columns;
      justify-content: center;
    }
    .terminal-box {
      margin-top: 2rem;
      display: flex;
      justify-content: center;
    }
  }

  .tona-grid {
    --height-offset: calc(var(--navbar-height) + calc(var(--spacing) * 4));
    max-height: calc(100vh - var(--height-offset));
  }
</style>
