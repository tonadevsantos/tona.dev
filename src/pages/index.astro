---
import Layout from "../layouts/Layout.astro";
import Tona from "../views/Tona.astro";
import AppBox from "../apps/AppBox.astro";
---

<Layout title="tona.dev / Sup!">
  <main>
    <div class="hero">
      <div class="main-hero">
        <div class="tona-box">
          <Tona />
        </div>
        <div class="terminal-box">
          <AppBox />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style lang="scss">
  @import "../styles/theme.scss";

  .hero {
    @include md {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    @include xl {
      margin-top: calc(35dvh - $navbar-height-tablet);
    }
  }

  .main-hero {
    display: flex;
    justify-content: center;
    flex-direction: column;
    width: 100%;
    gap: 2rem;

    @include xl {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .tona-box {
      @extend %box-padding;

      height: 100%;

      display: flex;
      flex-direction: columns;
      justify-content: center;
    }
    .terminal-box {
      margin-top: 2rem;
      display: flex;
      justify-content: center;
    }
  }
</style>
