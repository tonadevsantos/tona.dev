---
import Layout from "../layouts/Layout.astro";
import Tona from "../views/Tona.astro";
import Window from "../components/Window.astro";
import Display from "../views/Display.astro";
import MyLinks from "../views/MyLinks.astro";
---

<Layout title="tona.dev / Sup!">
  <div class="tona-grid grid grid-cols-3 gap-4 px-4">
    <div class="col-span-3 md:col-span-2">
      <Window>
        <Tona />
      </Window>
    </div>
    <div class="col-span-2 md:col-span-1">
      <Window class="flex flex-col justify-center">
        <Display />
      </Window>
    </div>
    <div class="col-span-1 col-row-1 md:col-span-3">
      <Window
        bodyClass="min-h-full md:min-h-50 flex flex-col items-center justify-center"
      >
        <MyLinks />
      </Window>
    </div>
  </div>
</Layout>

<style lang="scss">
  .tona-grid {
    --height-offset: calc(var(--navbar-height) + calc(var(--spacing) * 4));
    max-height: calc(100vh - var(--height-offset));
  }
</style>
