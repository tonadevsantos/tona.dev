---
import Frontmatter from "../../layouts/Frontmatter.astro";

const { name } = Astro.params;

let Content;
let frontmatter;
try {
  const Response = await import(`../../content/projects/${name}.md`);
  Content = Response.Content;
  frontmatter = Response.frontmatter;
} catch (error) {
  console.error("Error in [name].astro:", error);
}

if (!frontmatter) {
  return Astro.rewrite("/404");
}
---

<Frontmatter frontmatter={frontmatter}>
  <Content />
</Frontmatter>
