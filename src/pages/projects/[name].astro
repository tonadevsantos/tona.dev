---
import Frontmatter from "../../layouts/Frontmatter.astro";
import { getEntry, render } from "astro:content";

const { name } = Astro.params;

const entry = await getEntry("projects", name ?? "");

if (!entry) {
  return Astro.rewrite("/404");
}

const { Content } = await render(entry);
---

<Frontmatter frontmatter={entry.data}>
  <Content />
</Frontmatter>
