<nav class="navbar container mx-auto max-w-6xl pl-4">
  <a href="/" class="navbar-item navbar-item__header"> tona.dev </a>
</nav>
<style lang="scss">
  @use "sass:map";
  @import "../styles/theme.scss";

  .navbar {
    height: var(--navbar-height);
    background: $navbar-color-bg;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    @include md() {
      flex-direction: row;
      justify-content: flex-start;
    }

    .navbar-item__header {
      @include glowing-text($navbar-link-color);
      font-size: 2rem;
      transition: text-shadow 1s ease;
      font-weight: 700;

      &:hover {
        @include glowing-text(lighten($navbar-link-color, 15));
      }

      &:focus {
        outline: 2px solid $color-link;
        border-radius: 4px;
      }
    }

    .navbar-menu {
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }
</style>
