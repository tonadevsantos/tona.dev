---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  bodyClass?: string;
}

const props = Astro.props;
const { class: classes, bodyClass, ...rest } = props;
---

<div {...rest} class:list={["terminal", classes]}>
  <div class="terminal__title-bar"></div>
  <div class:list={["terminal__body", bodyClass]}>
    <slot />
  </div>
</div>
<style lang="scss">
  @import "../styles/theme.scss";

  $text-color: $color-text-value;

  .terminal {
    width: 100%;
    background-color: $terminal-color-bg;
    font-size: 1rem;
    font-family: monospace;
  }

  .terminal__body {
    overflow-y: auto;
  }

  .terminal__title-bar {
    height: 2rem;
    background-color: $terminal-title-bar-color-bg;
  }
</style>
