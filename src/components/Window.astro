---
interface Props {
  id?: string;
}

const props = Astro.props.id ? { id: Astro.props.id } : {};
---

<div class="terminal" {...props}>
  <div class="terminal__title-bar"></div>
  <div class="terminal__body">
    <slot />
  </div>
</div>
<style lang="scss">
  @import "../styles/theme.scss";

  $text-color: $color-text-value;

  .terminal {
    width: 100%;
    max-width: 1024px;
    height: 100%;
    min-height: 65vh;
    background-color: $terminal-color-bg;
    font-size: 1rem;
    font-family: monospace;

    @include glowing-text($text-color);

    @include md() {
      min-width: 640px;
      max-height: 762px;
      min-height: 320px;
    }
  }

  .terminal__body {
    overflow-y: auto;
    padding: 0.5rem 1rem;
    height: 100%;
  }

  .terminal__title-bar {
    height: 2rem;
    background-color: $terminal-title-bar-color-bg;
  }
</style>
