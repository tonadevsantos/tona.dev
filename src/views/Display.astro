---
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import prettyParamsDemo from "../media/pretty-params-product.png";
---

<div class="flex flex-col items-center gap-3 p-2 overflow-hidden">
  <div class="text-center mb-4">
    <h3 class="text-xl">Pretty Params</h3>
    <p>Handle URL search params with ease</p>
  </div>
  <div class="flex items-center justify-center">
    <Image
      class="max-w-lg"
      src={prettyParamsDemo}
      alt="Pretty Params demo screenshot"
      widths={[150, 300, 500, 800]}
    />
  </div>
  <p class="mb-4">Check out my browser extension</p>
  <Button href="/projects/pretty-params" class="font-sans">View More</Button>
</div>
