---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import type { Meta } from "../content.config";

export interface Props {
  title: string;
  meta?: Meta[];
}

const { title, meta = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {
      meta.map((m) => (
        <meta name={m.name} property={m.property} content={m.content} />
      ))
    }
    <title>{title}</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial,
          "Noto Sans",
          sans-serif,
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "Noto Color Emoji"; /* 1 */
        line-height: 1.5; /* 2 */
      }
    </style>
  </head>
  <body>
    <Navbar />
    <slot />
  </body>
</html>
<style lang="scss" is:global>
  @import "../styles/theme.scss";
  @import "tailwindcss";

  :root {
    @extend %root-colors;
  }

  html {
    color: $color-text;
    background-color: $color-bg;
  }

  body {
    min-height: 100vh;
  }

  a {
    text-decoration: none;
  }

  .glow-text {
    @include glowing-text($color-text-value);
  }

  .tona-container {
    @apply px-8 container max-w-4xl mx-auto text-justify leading-7 space-y-4;
  }
</style>
