---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;

const title = frontmatter.title || "tona.dev / Element!";
const meta = frontmatter.meta;
---

<Layout title={title} meta={meta}>
  <main
    class="px-8 ln-h container max-w-4xl mx-auto text-justify leading-7 space-y-4"
  >
    <slot />
  </main>
</Layout>

<style lang="scss" is:global>
  @import "tailwindcss";

  h1 {
    @apply text-4xl font-bold mb-4;
  }

  h2 {
    @apply text-2xl font-semibold mb-3;
  }

  h3 {
    @apply text-lg font-semibold mb-2;
  }

  p {
    a {
      color: var(--color-link);
    }
  }

  li {
    a {
      color: var(--color-link);
    }
  }

  ul {
    list-style: disc;
  }

  blockquote {
    @apply italic border-l-4 pl-4 my-4;
    border-color: var(--color-text-value);
    background: var(--color-bg-700);

    p {
      @apply truncate;
    }
  }

  code {
    @apply italic font-mono;
    background: var(--color-bg-700);
  }

  table {
    @apply border-collapse border;
    width: 100%;

    th {
      @apply border border-gray-200 p-2;
    }

    td {
      @apply border border-gray-200 p-2;
    }
  }
</style>
