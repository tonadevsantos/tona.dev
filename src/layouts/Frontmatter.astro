---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;

const title = frontmatter.title || "tona.dev / Element!";
const meta = frontmatter.meta;
---

<Layout title={title} meta={meta}>
  <main class="px-8 md:px-2 ln-h container mx-auto text-justify leading-7">
    <slot />
  </main>
</Layout>

<style lang="scss" is:global>
  @import "tailwindcss";

  h1 {
    @apply text-4xl font-bold mb-4;
  }

  h2 {
    @apply text-2xl font-semibold mb-3;
  }

  p {
    @apply mb-4;
  }

  blockquote {
    @apply italic border-l-4 pl-4 my-4;
    border-color: var(--color-text-value);
    background: var(--color-bg-700);

    p {
      @apply truncate;
    }
  }
</style>
